[Unit]
Description=IFD-2 — interface web "mots doux" pour la Xerox 575
Documentation=https://github.com/Pixayl/ta-typewriter-ifd1-replacement
# PAS de network-online.target : sur un Pi en Wi-Fi cette cible peut mettre une
# a deux minutes a etre atteinte, et le serveur n'en a pas besoin — il ecoute sur
# 0.0.0.0, ce qui fonctionne avant meme que le reseau soit monte. L'attendre ne
# faisait que retarder l'apparition de la page de plusieurs dizaines de secondes.
After=network.target

[Service]
Type=simple
User=__USER__
# dialout : indispensable pour ouvrir /dev/ttyACM0 sans etre root.
SupplementaryGroups=dialout
WorkingDirectory=__REPO__
ExecStart=/usr/bin/python3 __REPO__/tools/serve.py --host 0.0.0.0
Restart=always
RestartSec=5
# Journalisation via journalctl : journalctl -u ifd2-web -f
StandardOutput=journal
StandardError=journal

# Durcissement raisonnable : le service n'a besoin que du port serie.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/dev

[Install]
WantedBy=multi-user.target
